generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Building {
  id        Int           @id @default(autoincrement())
  name      String
  street    String        @default("")
  number    String        @default("")
  city      String        @default("")
  groups    ScreenGroup[]
  createdAt DateTime      @default(now())
}

model ScreenGroup {
  id         Int      @id @default(autoincrement())
  name       String
  street     String   @default("")
  number     String   @default("")
  city       String   @default("")
  theme      String   @default("modern")
  logoUrl    String   @default("")
  newsSource String   @default("ynet")
  musicUrl   String   @default("")
  buildingId Int?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  screens    Screen[]
  slides     Slide[]
  notices    Notice[]
  tickers    Ticker[]
  floors     Floor[]
  createdAt  DateTime @default(now())
}

model Screen {
  id         Int          @id @default(autoincrement())
  name       String
  street     String       @default("")
  number     String       @default("")
  city       String       @default("")
  theme      String       @default("modern")
  logoUrl    String       @default("")
  newsSource String       @default("ynet")
  groupId    Int?
  group      ScreenGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  slides     Slide[]
  notices    Notice[]
  createdAt  DateTime     @default(now())
}

model Slide {
  id        Int          @id @default(autoincrement())
  screenId  Int?
  screen    Screen?      @relation(fields: [screenId], references: [id], onDelete: Cascade)
  groupId   Int?
  group     ScreenGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  imageUrl  String
  sort      Int          @default(0)
  duration  Int          @default(8)
  active    Boolean      @default(true)
  weekdays  String       @default("0123456")
  createdAt DateTime     @default(now())
}

model Notice {
  id        Int          @id @default(autoincrement())
  screenId  Int?
  screen    Screen?      @relation(fields: [screenId], references: [id], onDelete: Cascade)
  groupId   Int?
  group     ScreenGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  text      String
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
}

model NewsItem {
  id        Int      @id @default(autoincrement())
  source    String
  title     String
  link      String   @default("")
  updatedAt DateTime @default(now())

  @@index([source])
}

model Feed {
  id   String @id
  name String
  url  String
}

model Ticker {
  id      Int         @id @default(autoincrement())
  groupId Int
  group   ScreenGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  text    String
  active  Boolean     @default(true)
}

model Floor {
  id      Int         @id @default(autoincrement())
  groupId Int
  group   ScreenGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name    String
  rooms   Room[]
}

model Room {
  id      Int    @id @default(autoincrement())
  floorId Int
  floor   Floor  @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name    String
  detail  String @default("")
}
