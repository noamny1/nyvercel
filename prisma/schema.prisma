generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String   @default("")
  role         String   @default("client")
  totpSecret   String   @default("")
  totpPending  String   @default("")
  screens       Screen[]
  groupLinks   GroupManager[]
  createdAt    DateTime @default(now())

  @@index([role, name])
}

model Building {
  id        Int           @id @default(autoincrement())
  name      String
  street    String        @default("")
  number    String        @default("")
  city      String        @default("")
  groups    ScreenGroup[]
  createdAt DateTime      @default(now())
}

model ScreenGroup {
  id         Int      @id @default(autoincrement())
  name       String
  street     String   @default("")
  number     String   @default("")
  city       String   @default("")
  theme      String   @default("modern")
  logoUrl    String   @default("")
  promoUrl   String   @default("")
  promoSeconds Int     @default(20)
  newsSource String   @default("ynet")
  musicUrl   String   @default("")
  buildingId Int?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  screens    Screen[]
  groupLinks GroupManager[]
  slides     Slide[]
  notices    Notice[]
  tickers    Ticker[]
  floors     Floor[]
  createdAt  DateTime @default(now())
}

model GroupManager {
  groupId Int
  userId  Int
  group   ScreenGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model Screen {
  id         Int          @id @default(autoincrement())
  name       String
  street     String       @default("")
  number     String       @default("")
  city       String       @default("")
  floor      String       @default("לובי")
  listSort   Int          @default(0)
  theme      String       @default("modern")
  logoUrl    String       @default("")
  newsSource String       @default("ynet")
  newsCount  Int          @default(8)
  tickerSeconds Int       @default(12)
  newsTicker String      @default("on")
  feedMode   String       @default("both")
  groupId    Int?
  group      ScreenGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  active     Boolean      @default(true)
  lastPing   DateTime?
  code       Int?         @unique
  revision   Int          @default(1)
  musicPlaylist String    @default("")
  heartbeat  Heartbeat?
  remoteDesk RemoteDesk?
  deviceStatus DeviceStatus?
  remoteCommands RemoteCommand[]
  users      User[]
  slides     Slide[]
  notices    Notice[]
  updates    Update[]
  createdAt  DateTime     @default(now())

  @@index([groupId])
  @@index([lastPing])
  @@index([street])
  @@index([city])
}

model Heartbeat {
  screenId Int      @id
  screen   Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  at       DateTime @default(now())

  @@index([at])
}

model RemoteDesk {
  screenId  Int      @id
  screen    Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  watchedAt DateTime @default(now())
  frame     Bytes?
  frameAt   DateTime?
  width     Int      @default(0)
  height    Int      @default(0)
  apps      String   @default("")
  note      String   @default("")
  shellOut  String   @default("")
  shellUntil DateTime?
  logOut    String   @default("")
  seenAt     DateTime?
  upgradeUrl String   @default("")
  lastApk    String   @default("")
  keeperAt   DateTime?
  keeper2At  DateTime?
  mediaPausedUntil DateTime?
  wakeUntil  DateTime?
  revivedAt  DateTime?
  k2Beat    DateTime?
  nykAt     DateTime?
  nykBeat   DateTime?
}

model DeviceStatus {
  screenId   Int      @id
  screen     Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  version    String   @default("")
  resolution String   @default("")
  ip         String   @default("")
  freeMb     Int      @default(0)
  bootedAt   DateTime?
  at         DateTime @default(now())
}

model ShellAudit {
  id        Int      @id @default(autoincrement())
  screenId  Int
  email     String
  command   String
  at        DateTime @default(now())

  @@index([screenId, at])
}

model RemoteCommand {
  id        Int      @id @default(autoincrement())
  screenId  Int
  screen    Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  op        String
  x         Int      @default(0)
  y         Int      @default(0)
  x2        Int      @default(0)
  y2        Int      @default(0)
  text      String   @default("")
  createdAt DateTime @default(now())

  @@index([screenId, id])
}

model Slide {
  id        Int          @id @default(autoincrement())
  screenId  Int?
  screen    Screen?      @relation(fields: [screenId], references: [id], onDelete: Cascade)
  groupId   Int?
  group     ScreenGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  imageUrl  String
  kind      String       @default("image")
  templateId String      @default("")
  title     String       @default("")
  detail    String       @default("")
  meta      String       @default("")
  sort      Int          @default(0)
  duration  Int          @default(8)
  active    Boolean      @default(true)
  weekdays  String       @default("01234")
  startsOn  String       @default("")
  endsOn    String       @default("")
  createdAt DateTime     @default(now())
}

model Notice {
  id        Int          @id @default(autoincrement())
  screenId  Int?
  screen    Screen?      @relation(fields: [screenId], references: [id], onDelete: Cascade)
  groupId   Int?
  group     ScreenGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  text      String
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
}

model NewsItem {
  id        Int      @id @default(autoincrement())
  source    String
  title     String
  link      String   @default("")
  updatedAt DateTime @default(now())

  @@index([source])
}

model Feed {
  id   String @id
  name String
  url  String
}

model Ticker {
  id      Int         @id @default(autoincrement())
  groupId Int
  group   ScreenGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  text    String
  active  Boolean     @default(true)
}

model Update {
  id        Int      @id @default(autoincrement())
  text      String
  active    Boolean  @default(true)
  screens   Screen[]
  createdAt DateTime @default(now())
}

model Floor {
  id      Int         @id @default(autoincrement())
  groupId Int
  group   ScreenGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name    String
  rooms   Room[]
}

model SystemFlag {
  id    String @id
  value String @default("")
}

model FileLink {
  token     String   @id
  url       String
  name      String   @default("")
  mime      String   @default("")
  createdAt DateTime @default(now())
}

model Room {
  id      Int    @id @default(autoincrement())
  floorId Int
  floor   Floor  @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name    String
  detail  String @default("")
}
