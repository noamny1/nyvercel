generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  passwordCopy String   @default("")
  name         String   @default("")
  role         String   @default("client")
  totpSecret   String   @default("")
  totpPending  String   @default("")
  screens       Screen[]
  groupLinks   GroupManager[]
  createdAt    DateTime @default(now())

  @@index([role, name])
}

model Building {
  id        Int           @id @default(autoincrement())
  name      String
  street    String        @default("")
  number    String        @default("")
  city      String        @default("")
  groups    ScreenGroup[]
  createdAt DateTime      @default(now())
}

model ScreenGroup {
  id         Int      @id @default(autoincrement())
  name       String
  street     String   @default("")
  number     String   @default("")
  city       String   @default("")
  theme      String   @default("modern")
  logoUrl    String   @default("")
  buildingLogo String @default("")
  faultPhone String   @default("")
  faultLink  String   @default("")
  faultQrUrl String   @default("")
  promoUrl   String   @default("")
  promoSeconds Int     @default(20)
  newsSource String   @default("ynet")
  musicUrl   String   @default("")
  floorPace  Int      @default(28)
  floorCaption String @default("name")
  serviceOn  Boolean  @default(true)
  buildingId Int?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  screens    Screen[]
  groupLinks GroupManager[]
  slides     Slide[]
  notices    Notice[]
  tickers    Ticker[]
  floors     Floor[]
  createdAt  DateTime @default(now())
}

model GroupManager {
  groupId Int
  userId  Int
  group   ScreenGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model Screen {
  id         Int          @id @default(autoincrement())
  name       String
  street     String       @default("")
  number     String       @default("")
  city       String       @default("")
  floor      String       @default("לובי")
  listSort   Int          @default(0)
  theme      String       @default("modern")
  logoUrl    String       @default("")
  buildingLogo String     @default("")
  faultPhone String       @default("")
  faultLink  String       @default("")
  faultQrUrl String       @default("")
  newsSource String       @default("ynet")
  newsCount  Int          @default(8)
  tickerSeconds Int       @default(12)
  floorPace  Int          @default(28)
  floorCaption String     @default("name")
  newsTicker String      @default("on")
  feedMode   String       @default("both")
  groupId    Int?
  group      ScreenGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  active     Boolean      @default(true)
  serviceOn  Boolean      @default(true)
  lastPing   DateTime?
  code       Int?         @unique
  revision   Int          @default(1)
  musicPlaylist String    @default("")
  musicDays     String    @default("0,1,2,3,4")
  musicFrom     String    @default("07:00")
  musicUntil    String    @default("22:30")
  heartbeat  Heartbeat?
  remoteDesk RemoteDesk?
  deviceStatus DeviceStatus?
  remoteCommands RemoteCommand[]
  users      User[]
  slides     Slide[]
  notices    Notice[]
  updates    Update[]
  floors     Floor[]
  createdAt  DateTime     @default(now())

  @@index([groupId])
  @@index([lastPing])
  @@index([street])
  @@index([city])
}

model Heartbeat {
  screenId Int       @id
  screen   Screen    @relation(fields: [screenId], references: [id], onDelete: Cascade)
  at       DateTime  @default(now())
  musicAt  DateTime?

  @@index([at])
}

model RemoteDesk {
  screenId  Int      @id
  screen    Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  watchedAt DateTime @default(now())
  frame     Bytes?
  frameAt   DateTime?
  width     Int      @default(0)
  height    Int      @default(0)
  apps      String   @default("")
  note      String   @default("")
  shellOut  String   @default("")
  shellUntil DateTime?
  logOut    String   @default("")
  seenAt     DateTime?
  upgradeUrl String   @default("")
  lastApk    String   @default("")
  keeperAt   DateTime?
  keeper2At  DateTime?
  mediaPausedUntil DateTime?
  wakeUntil  DateTime?
  revivedAt  DateTime?
  k2Beat    DateTime?
  nykAt     DateTime?
  nykBeat   DateTime?
}

model DeviceStatus {
  screenId   Int      @id
  screen     Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  version    String   @default("")
  resolution String   @default("")
  ip         String   @default("")
  freeMb     Int      @default(0)
  bootedAt   DateTime?
  at         DateTime @default(now())
}

model ShellAudit {
  id        Int      @id @default(autoincrement())
  screenId  Int
  email     String
  command   String
  at        DateTime @default(now())

  @@index([screenId, at])
}

model RemoteCommand {
  id        Int      @id @default(autoincrement())
  screenId  Int
  screen    Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  op        String
  x         Int      @default(0)
  y         Int      @default(0)
  x2        Int      @default(0)
  y2        Int      @default(0)
  text      String   @default("")
  createdAt DateTime @default(now())

  @@index([screenId, id])
}

model Slide {
  id        Int          @id @default(autoincrement())
  screenId  Int?
  screen    Screen?      @relation(fields: [screenId], references: [id], onDelete: Cascade)
  groupId   Int?
  group     ScreenGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  imageUrl  String
  kind      String       @default("image")
  templateId String      @default("")
  title     String       @default("")
  detail    String       @default("")
  meta      String       @default("")
  sort      Int          @default(0)
  duration  Int          @default(8)
  active    Boolean      @default(true)
  weekdays  String       @default("01234")
  startsOn  String       @default("")
  endsOn    String       @default("")
  createdAt DateTime     @default(now())
}

model Notice {
  id        Int          @id @default(autoincrement())
  screenId  Int?
  screen    Screen?      @relation(fields: [screenId], references: [id], onDelete: Cascade)
  groupId   Int?
  group     ScreenGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  text      String
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
}

model NewsItem {
  id        Int      @id @default(autoincrement())
  source    String
  title     String
  link      String   @default("")
  updatedAt DateTime @default(now())

  @@index([source])
}

model Feed {
  id   String @id
  name String
  url  String
}

model Ticker {
  id      Int         @id @default(autoincrement())
  groupId Int
  group   ScreenGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  text    String
  active  Boolean     @default(true)
}

model Update {
  id        Int      @id @default(autoincrement())
  text      String
  active    Boolean  @default(true)
  screens   Screen[]
  createdAt DateTime @default(now())
}

model Floor {
  id       Int          @id @default(autoincrement())
  groupId  Int?
  group    ScreenGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  screenId Int?
  screen   Screen?      @relation(fields: [screenId], references: [id], onDelete: Cascade)
  name     String
  rooms    Room[]

  @@index([groupId])
  @@index([screenId])
}

model SystemFlag {
  id    String @id
  value String @default("")
}

model FileLink {
  token     String   @id
  url       String
  name      String   @default("")
  mime      String   @default("")
  createdAt DateTime @default(now())
}

model Room {
  id        Int    @id @default(autoincrement())
  floorId   Int
  floor     Floor  @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name      String
  detail    String @default("")
  logoUrl   String @default("")
  specialty String @default("")
}


model CrmClient {
  id             Int       @id @default(autoincrement())
  name           String
  city           String?
  status         String?
  workContent    String?
  notes          String?
  oneTimeCharge  Float?
  monthlyPay     Float?
  monthlyPay2    Float?
  internetCost   Float?
  clientType     String?
  infrastructure String?
  paymentMethod  String?
  theme          String?
  installDate    DateTime?
  hotLine        String?
  ipDns          String?
  loginUser      String?
  loginPass      String?
  modemData      String?
  subscriberId   String?
  modemPass      String?
  dvrType        String?
  dvrIp          String?
  dvrPorts       String?
  dvrUser        String?
  dvrPass        String?
  screenCount    Int?
  addressCount   Int?
  bank           String?
  branch         String?
  account        String?
  files          String?
  paidUntil      String?
  mondayId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tasks          CrmTask[]
}

model CrmEmployee {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?  @unique
  phone     String?
  role      String   @default("employee")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  tasks     CrmTask[]
}

model CrmTask {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  status      String   @default("open")
  priority    String   @default("normal")
  dueDate     DateTime?
  clientId    Int?
  client      CrmClient? @relation(fields: [clientId], references: [id])
  employeeId  Int?
  employee    CrmEmployee? @relation(fields: [employeeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
